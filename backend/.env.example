# 복사해서 .env 또는 셸 환경 변수로 사용한다. 실제 비밀값은 커밋하지 않는다.
SHIPYARD_DB_PATH=database/shipyard.db
# APP_SECRET 미설정 시 프로세스별 난수(재시작하면 기존 토큰 무효)
APP_SECRET=
TOKEN_TTL=28800
OTP_TOKEN_TTL=300
SHIPYARD_FILE_DIR=storage/drawings
WEATHER_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT=90
SHIPYARD_REPORT_FONT=
SHIPYARD_DEMO=
