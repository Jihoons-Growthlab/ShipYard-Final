{
  "ports": {
    "backend": 8100,
    "frontend": 5273,
    "ollama": 11434,
    "note": "Ver3·다른 세션(8000/5173)과 겹치지 않게. 환경 변수 SHIPYARD_BACKEND_PORT·SHIPYARD_FRONTEND_PORT가 우선. dev·shots·verify가 이 값을 쓰고 Vite는 같은 환경 변수를 읽는다."
  },
  "launch": {
    "command": [
      "claude",
      "--model",
      "claude-opus-5-5",
      "--effort",
      "medium",
      "--permission-mode",
      "auto",
      "--strict-mcp-config"
    ],
    "env": {
      "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
    },
    "prompt": "/build",
    "active_minutes": 15
  },
  "env_checks": {
    "node": [
      "node",
      "-v"
    ],
    "npm": [
      "npm",
      "-v"
    ],
    "uv": [
      "uv",
      "--version"
    ],
    "chrome": [
      "test",
      "-d",
      "/Applications/Google Chrome.app"
    ],
    "unity": [
      "python3",
      "scripts/wf.py",
      "unity-path"
    ],
    "ollama": [
      "sh",
      "-c",
      "command -v ollama >/dev/null && ollama --version 2>/dev/null | tail -1"
    ],
    "ollama_model": [
      "sh",
      "-c",
      "curl -s -m 3 \"${OLLAMA_BASE_URL:-http://127.0.0.1:11434}/api/tags\" | grep -q \"\\\"${OLLAMA_MODEL:-qwen2.5:1.5b-instruct}\\\"\" && echo \"${OLLAMA_MODEL:-qwen2.5:1.5b-instruct}\""
    ],
    "korean_font": [
      "sh",
      "-c",
      "test -f /System/Library/Fonts/AppleSDGothicNeo.ttc && echo AppleSDGothicNeo || test -n \"$SHIPYARD_REPORT_FONT\" && echo env"
    ]
  },
  "verify": {
    "backend": {
      "cwd": "backend",
      "cmd": [
        "uv",
        "run",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "parser": "pytest",
      "timeout": 900
    },
    "frontend": {
      "cwd": "frontend",
      "cmd": [
        "npx",
        "vitest",
        "run"
      ],
      "parser": "vitest",
      "timeout": 900
    },
    "build": {
      "cwd": "frontend",
      "cmd": [
        "npx",
        "vite",
        "build"
      ],
      "parser": "generic",
      "timeout": 600
    },
    "unity": {
      "cwd": ".",
      "cmd": [
        "{unity}",
        "-batchmode",
        "-quit",
        "-buildTarget",
        "WebGL",
        "-projectPath",
        "unity/ShipyardViewer",
        "-executeMethod",
        "ViewerBuild.Build",
        "-logFile",
        "-"
      ],
      "parser": "unity",
      "timeout": 3600
    },
    "all": [
      "backend",
      "frontend",
      "build"
    ]
  },
  "dev": {
    "seed": {
      "cwd": "backend",
      "cmd": [
        "uv",
        "run",
        "init-db",
        "--seed",
        "--demo-pdfs",
        "--demo-usage"
      ]
    },
    "services": {
      "backend": {
        "cwd": "backend",
        "cmd": [
          "uv",
          "run",
          "uvicorn",
          "app.main:app",
          "--host",
          "127.0.0.1",
          "--port",
          "{backend_port}"
        ],
        "port": "{backend_port}",
        "health": "http://127.0.0.1:{backend_port}/api/health"
      },
      "frontend": {
        "cwd": "frontend",
        "cmd": [
          "npx",
          "vite",
          "--host",
          "127.0.0.1",
          "--port",
          "{frontend_port}",
          "--strictPort"
        ],
        "port": "{frontend_port}",
        "health": "http://127.0.0.1:{frontend_port}/"
      }
    },
    "fresh_env": {
      "SHIPYARD_DB_PATH": "state/run/fresh.db",
      "SHIPYARD_FILE_DIR": "state/run/files"
    },
    "health_timeout": 60,
    "default_db": "database/shipyard.db"
  },
  "shots": {
    "base_url": "http://127.0.0.1:{frontend_port}",
    "refs": "reference/ui",
    "seed": "reference/seed/seed.json",
    "flows": "state/shots.json",
    "out": "reports/shots",
    "browser_channel": "chrome",
    "default_viewport": [
      1440,
      900
    ],
    "pixel_tolerance": 32,
    "threshold": 0.08,
    "step_timeout_ms": 10000,
    "mutating_result": "state/shots-mutating-result.json"
  },
  "srcmap": {
    "out": "state/SOURCEMAP.md",
    "roots": [
      "backend/app",
      "backend/tests",
      "frontend/src",
      "unity/ShipyardViewer/Assets"
    ],
    "openapi_cmd": {
      "cwd": "backend",
      "cmd": [
        "uv",
        "run",
        "python",
        "-c",
        "import json; from app.main import app; print(json.dumps(app.openapi()))"
      ],
      "timeout": 60
    },
    "max_bytes": 14000
  },
  "progress": {
    "file": "state/PROGRESS.md",
    "max_lines": 40
  },
  "track": {
    "roots": [
      "backend/app",
      "backend/tests",
      "backend/pyproject.toml",
      "backend/.env.example",
      "frontend/src",
      "frontend/tests",
      "frontend/index.html",
      "frontend/vite.config.js",
      "frontend/package.json",
      "database/migrations",
      "unity/ShipyardViewer/Assets",
      "scripts/demo.sh"
    ],
    "note": "task-done 때 마지막 스냅샷(state/run/files.json, mtime·크기)과 비교해 변경 파일을 state/tasks.json에 남긴다. git 불필요."
  },
  "verify_guard": {
    "max_same_failures": 2,
    "note": "같은 대상·인자가 코드 변경 없이 연속 실패하면 다음 실행을 거부(--force로 해제)."
  }
}